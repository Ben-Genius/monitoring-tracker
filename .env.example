VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Baserow database token (Baserow -> Settings -> Database tokens).
# SERVER-SIDE ONLY - deliberately has no VITE_ prefix. Anything prefixed VITE_
# is inlined into the browser bundle, and this token grants access to every
# table it is scoped to.
BASEROW_TOKEN=your_baserow_database_token

# Service-role key for the Baserow -> Supabase sync. Bypasses ALL row level
# security, so it is server-side only and must never gain a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Shared secret guarding the sync endpoints. Without it, anyone could POST to
# /api/baserow/sync-* and write to your database.
SYNC_SECRET=generate_a_long_random_string

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` on its GET requests.
# Set this in the Vercel dashboard; without it the scheduled syncs are rejected
# as unauthorized (the endpoints fail closed by design).
CRON_SECRET=generate_a_long_random_string
